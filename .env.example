SQL_DB=sigse
SQL_PORT=127.0.0.1:3306
SQL_USER=user1
SQL_PASSWORD=UPassword
SQL_PASSWORD_ROOT=RPassword

# Puerto HTTP de Express.
PORT=3000

# La API local usa 127.0.0.1 y el puerto publicado en SQL_PORT.
# Dentro de la red de Compose, usa el nombre y el puerto interno del servicio.
# DB_HOST=db
# DB_PORT=3306

# Orígenes web permitidos por CORS, separados por comas (sin barra final).
# Sin esta variable, en desarrollo se acepta cualquier localhost; en producción
# no se acepta ningún origen del navegador. Ejemplo para producción:
# CORS_ORIGIN=https://tu-web.example.com
