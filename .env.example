# MySQL. docker-compose.yml y la API leen las mismas variables.
# Compose publica MySQL solo en 127.0.0.1:DB_PORT. Si la API corre dentro de la red
# de Compose, usa DB_HOST=db y DB_PORT=3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigse
DB_USER=user1
DB_PASSWORD=UPassword
DB_ROOT_PASSWORD=RPassword

# Entorno. En local usa development; el servidor de producción debe usar production.
# Con development o test se permite el JWT_SECRET de ejemplo; con cualquier otro
# valor (o sin definirlo) la API no arranca mientras el secreto sea el de ejemplo.
NODE_ENV=development

# Puerto HTTP de Express.
PORT=3000

# Carpeta de archivos de evidencia. Por defecto se usa backend/uploads (o /app/uploads en Docker).
# UPLOAD_DIR=uploads

# Orígenes web permitidos por CORS, separados por comas (sin barra final).
# Sin esta variable, en desarrollo se acepta cualquier localhost; en producción
# no se acepta ningún origen del navegador. Ejemplo para producción:
# CORS_ORIGIN=https://tu-web.example.com

# Secreto para firmar los JWT (mínimo 32 caracteres). Cámbialo por uno propio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# El valor de ejemplo es solo para desarrollo local; nunca lo uses publicado.
JWT_SECRET=cambia-este-secreto-de-desarrollo-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Pruebas de integración del backend contra MySQL (opcional en local; el CI las ejecuta).
# Sin TEST_MYSQL_PORT, `npm test` se salta esa suite. Usa una instancia de pruebas: la suite
# crea y borra un esquema temporal con la cuenta root.
# TEST_MYSQL_PORT=3306
# TEST_MYSQL_PASSWORD=RPassword
